.post-wrapper {
  display: flex;
  gap: 2rem;
  align-items: flex-start;
}

.post-content {
  flex: 1;
}

.toc-sidebar {
  width: 250px;
  position: sticky;
  top: 2rem; /* stays fixed while scrolling */
}

/* Hide on smaller mobile screens */
@media (max-width: 768px) {
  .post-wrapper {
    flex-direction: column;
  }
  .toc-sidebar {
    width: 100%;
    position: static;
  }
}
